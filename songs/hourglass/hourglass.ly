\version "2.24.3"
%% "Hourglass" -- for four voices, celesta, violins, cello, timpani and piano.
%%
%% A palindrome in four tempi.  The soprano's opening tune (bars 3-10, C minor,
%% crotchet = 48) returns at the end (bars 42-49) as its exact retrograde: the
%% same twenty notes in reverse order, with the same durations reversed, sung by
%% the tenor an octave down.  The words reverse with it -- the first phrase
%% "Fall, we shall, as sand" comes back as "sand, as shall we fall" -- and the
%% harmony underneath is re-read from C minor into E-flat major, the relative
%% major, so the identical pitches that were grief on the way down are consent
%% on the way back.
%%
%% Between the two halves the glass is turned.  Bars 11-30 are in 7/8 -- seven
%% quavers, because a seven-note scale then fills exactly one bar -- and the
%% tempo steps up every four bars while the mode darkens with it:
%%
%%     bars 11-14  transition       C aeolian        ♪ = 112 .. 160
%%     bars 15-18  hocket, solo     C aeolian        ♪ = 176
%%     bars 19-22  hocket, pairs    C dorian         ♪ = 200
%%     bars 23-26  hocket, pairs    C harmonic minor ♪ = 224
%%     bars 27-30  tutti            C phrygian dom.  ♪ = 248
%%
%% The hocket is a single seven-syllable line per bar passed between the four
%% voices one syllable at a time (soprano, alto, tenor, bass, soprano ...),
%% each voice taking the note in its own octave, so the tune is heard across
%% three octaves at once and no singer ever holds it for more than a quaver.
%% Seven syllables over four voices means the rotation only comes round every
%% four bars, which is why each step is four bars long.  Under it the violins
%% play a Shepard rise: two voices a bar apart, each climbing one octave per
%% bar, swelling on the way up and fading at the top, so the strings appear to
%% ascend for twenty bars without ever arriving.  The piano's ostinato groups
%% the bar 2+2+3 and the celesta ticks 3+2+2 against it.
%%
%% Bars 31-38 are the glass breaking: 4/4, crotchet = 132, parallel thirds in
%% octaves over tremolo, a held cluster, three stabs, and a general pause at
%% crotchet = 44 that the MIDI actually observes.  The celesta, silent through
%% all of that, is what is left ticking afterwards.
%%
%% Every voice part uses ties rather than extenders for held notes, so each
%% part's syllable count is exactly its number of untied notes and a miscount
%% is a LilyPond warning rather than a line that sings a word late.
%%
%% The hocket and the Shepard rise are generated by make_score.py in this
%% directory; everything else is written by hand.  hourglass.ly is the result
%% and is the file to compile.

#(set-global-staff-size 12)
\paper {
  #(set-paper-size "a4landscape")
  ragged-last-bottom = ##f
  system-system-spacing.basic-distance = #12
  top-margin = 8\mm
  bottom-margin = 8\mm
  left-margin = 12\mm
  right-margin = 10\mm
}

\header {
  title = "Hourglass"
  subtitle = "a palindrome in four tempi, for four voices, celesta, strings, timpani and piano"
  composer = "original composition"
  tagline = ##f
}

%% ---------------------------------------------------------------- the spine
%% Metre, key and every tempo in one place; each staff runs it alongside its
%% own notes.  Hidden tempo marks are the ones a conductor would take by feel:
%% the general pause and the staged ritardando at the end.
global = {
  \key c \minor
  \time 5/4 \tempo "I. Sand" 4 = 48
  s4*5*10 |
  \time 7/8 \tempo "II. Turning" 8 = 112 s8*7 |
  \tempo 8 = 128 s8*7 |
  \tempo 8 = 144 s8*7 |
  \tempo 8 = 160 s8*7 |
  \tempo 8 = 176 s8*7*4 |
  \tempo 8 = 200 s8*7*4 |
  \tempo 8 = 224 s8*7*4 |
  \tempo 8 = 248 s8*7*4 |
  \time 4/4 \tempo "III. Shatter" 4 = 132 s1*8 |
  \once \omit Score.MetronomeMark \tempo 4 = 44 s1 |
  \tempo 4 = 60 s1*2 |
  \time 5/4 \key ees \major \tempo "IV. Glass (Tempo I)" 4 = 48 s4*5*4 |
  \once \omit Score.MetronomeMark \tempo 4 = 44 s4*5*2 |
  \once \omit Score.MetronomeMark \tempo 4 = 40 s4*5*2 |
  \once \omit Score.MetronomeMark \tempo 4 = 36 s4*5 |
  \once \omit Score.MetronomeMark \tempo 4 = 32 s4*5 |
}

%% Two bars a system in 5/4, four in 7/8 and 4/4: the playhead in the video
%% then moves at much the same speed across the page whatever the metre.
breaks = {
  \repeat unfold 5 { s4*5*2 \break }
  \repeat unfold 5 { s8*7*4 \break }
  s1*4 \break s1*4 \break s1*3 \break
  \repeat unfold 4 { s4*5*2 \break } s4*5*2
}

