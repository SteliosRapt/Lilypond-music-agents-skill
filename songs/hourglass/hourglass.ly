  aes8 c' ees' aes' c'' aes' bes d' f' bes' |
  ees'8 g' bes' ees'' g'' ees'' bes' g' ees' g' |
  <g' bes' ees''>1\pp\>~ <g' bes' ees''>4~ | <g' bes' ees''>1~ <g' bes' ees''>4\! \bar "|."
}

